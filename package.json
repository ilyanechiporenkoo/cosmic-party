{
  "name": "cosmic-party",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "content:fetch": "tsx scripts/fetch-wikidata.ts",
    "content:build": "tsx scripts/build-content.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "content:templates": "tsx scripts/fetch-templates.ts --parallel=5"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "express": "^5.3.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
